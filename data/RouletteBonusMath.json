  "bonus_state_patterns": [
    { "substring": "GoldenFrame", "display_label": "Golden Frame" },
    { "substring": "Golden_Frame", "display_label": "Golden Frame" },
    { "substring": "CreditWin", "display_label": "Credit Win" },
    { "substring": "Credit_Win", "display_label": "Credit Win" },
    { "substring": "RouletteBonus", "display_label": "Roulette Bonus" },
    { "substring": "Roulette_Bonus", "display_label": "Roulette Bonus" },
    { "substring": "FreeSpin", "display_label": "Free Spins" },
    { "substring": "Free_Spin", "display_label": "Free Spins" },
    { "substring": "PickBonus", "display_label": "Pick Bonus" },
    { "substring": ".Bonus", "display_label": "Bonus" }
  ]
